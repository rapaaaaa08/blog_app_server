# ===== Database (default Laragon: user root tanpa password) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_blog_app

# ===== JWT (dipakai fitur register/login) =====
JWT_SECRET=ganti_dengan_rahasia_kamu

# ===== Cloudinary (upload gambar artikel & avatar) =====
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxx
