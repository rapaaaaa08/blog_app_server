{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist", // Folder hasil compile ke JS
    "rootDir": "./src", // Folder tempat kode TS kamu
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // Cukup file di src/ yang di-typecheck.
  // drizzle.config.ts ada di luar rootDir, jadi kalau ikut diambil `tsc` bakal error TS6059.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
